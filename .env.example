APP_NAME=CleanCong
APP_ENV=local
APP_KEY=base64:YourAppKeyGoesHere=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cleancong_laundry
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120

# Midtrans Payment Gateway Configuration
# Mode: Sandbox (Uji Coba) vs Production
MIDTRANS_SERVER_KEY="SB-Mid-server-YourSandboxServerKey"
MIDTRANS_CLIENT_KEY="SB-Mid-client-YourSandboxClientKey"
MIDTRANS_IS_PRODUCTION=false
MIDTRANS_IS_SANITIZED=true
MIDTRANS_IS_3DS=true

# Google Gemini API (AI Smart Assistant CleanCong)
GEMINI_API_KEY="your-gemini-api-key"
